# Supabase. EXPO_PUBLIC_ znaci da se vrednost UGRADJUJE u aplikaciju i vidljiva je
# svakome ko je raspakuje. To je u redu SAMO za anon (publishable) kljuc, koji je
# po dizajnu javan — podatke stiti Row Level Security, ne tajnost kljuca.
#
# NIKAD ovde ne stavljaj service_role kljuc. On zaobilazi RLS i daje pun pristup
# bazi; njegovo mesto je iskljucivo na serveru (RevenueCat webhook, cron poslovi).

EXPO_PUBLIC_SUPABASE_URL=https://<tvoj-projekat>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
