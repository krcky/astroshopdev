{
  "expo": {
    "name": "Astroshop",
    "slug": "astroshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astroshop",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.krcky.astroshop",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Astro Shop dodaje sliku u Fotografije samo kad pri deljenju izabereš „Sačuvaj sliku“."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.krcky.astroshop"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F8",
          "image": "./assets/images/splash-krug.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Astro Shop pristupa fotografijama samo kad izabereš sliku za svoj profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "krcky",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80bd5bd5-0efe-48b4-a039-4c85b7cd5a9f"
      }
    }
  }
}
